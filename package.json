{
  "name": "memoriano",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:vite:dev\"",
    "vite:dev": "vite --host 0.0.0.0",
    "server:dev": "node --watch server/index.js",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "vite": "^5.4.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
